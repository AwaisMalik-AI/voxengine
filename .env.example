# Copy to .env and fill in values. Never commit real secrets.

# --- Required ---
DATABASE_URL=postgresql+asyncpg://voxengine:voxengine@localhost:5432/voxengine
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars-long

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- App ---
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_PATH=./storage

# --- TTS ---
TTS_ENGINE=edge_tts
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Twilio (optional; calls are simulated if unset) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Limits ---
MAX_CONCURRENT_CALLS=10
DNC_ENABLED=true
WEBHOOK_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=120
DEFAULT_MONTHLY_CREDIT_QUOTA=10000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
